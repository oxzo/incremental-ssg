# Credentials for the public demo's R2 bucket.
#
# Copy to stack/env.r2.sh and fill in. That filename is gitignored, and the
# distinction matters: stack/env.sh holds *fixtures* for throwaway containers and
# is committed on purpose, while this file holds a real token for a real service
# and must never be. If you find yourself about to relax that, the fact that both
# files look alike is exactly why they are named differently.
#
#   source stack/env.sh && source stack/env.r2.sh
#
# The pipeline needs no code change to target R2: src/cli.ts builds an S3 target
# from these variables, and R2 speaks the S3 API.

# https://<account-id>.r2.cloudflarestorage.com  (Cloudflare dashboard -> R2)
export S3_ENDPOINT="https://REPLACE-ACCOUNT-ID.r2.cloudflarestorage.com"

# R2 has no regions. The S3 SDK insists on one, and `auto` is what R2 expects.
export S3_REGION="auto"

# An R2 API token with Object Read & Write on this bucket only.
export S3_ACCESS_KEY_ID="REPLACE"
export S3_SECRET_ACCESS_KEY="REPLACE"

# Must match bucket_name in demo/worker/wrangler.toml, or the Worker will serve
# an empty site while the deploy reports success.
export ISSG_DEMO_BUCKET="incremental-ssg-demo"
