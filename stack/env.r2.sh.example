# Credentials for the public demo's R2 bucket.
#
# Copy to stack/env.r2.sh and fill in. That filename is gitignored, and the
# distinction matters: stack/env.sh holds *fixtures* for throwaway containers and
# is committed on purpose, while this file holds a real token for a real service
# and must never be. If you find yourself about to relax that, the fact that both
# files look alike is exactly why they are named differently.
#
#   source stack/env.sh && source stack/env.r2.sh
#
# The pipeline needs no code change to target R2: src/cli.ts builds an S3 target
# from these variables, and R2 speaks the S3 API.

# https://<account-id>.r2.cloudflarestorage.com  (Cloudflare dashboard -> R2)
export S3_ENDPOINT="https://REPLACE-ACCOUNT-ID.r2.cloudflarestorage.com"

# R2 has no regions. The S3 SDK insists on one, and `auto` is what R2 expects.
export S3_REGION="auto"

# An R2 API token with **Object Read & Write**, scoped to this bucket alone.
#
# That is not a conservative guess, it is the measured surface: src/deploy-s3.ts
# issues exactly ListObjectsV2, PutObject and DeleteObjects, and Object Read &
# Write covers all three. Admin Read & Write also works and additionally grants
# bucket create/delete and configuration, none of which the pipeline ever calls.
# Bucket scoping is only offered on the Object-level permissions, which is a
# second reason not to reach for Admin.
#
# Getting the values here without exposing them: paste them from the dashboard
# straight into stack/env.r2.sh. They are needed in that file and nowhere else,
# and a value that is only ever `source`d cannot be leaked by a shell history, a
# `ps` listing, or a chat transcript -- which are the three ways it otherwise
# escapes. In particular do not type `export S3_SECRET_ACCESS_KEY=...` at a
# prompt: that lands in history and is visible to every user on the box for the
# life of the command.
#
# When a token is revoked, blank these rather than leaving the dead values in
# place. A dead credential left in the file reads as a live one to whoever finds
# it next, and the cost of that confusion is paid at exactly the wrong moment.
export S3_ACCESS_KEY_ID="REPLACE"
export S3_SECRET_ACCESS_KEY="REPLACE"

# Must match bucket_name in demo/worker/wrangler.toml, or the Worker will serve
# an empty site while the deploy reports success.
export ISSG_DEMO_BUCKET="incremental-ssg-demo"
